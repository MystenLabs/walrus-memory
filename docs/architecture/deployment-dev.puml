@startuml deployment-dev
' Deployment of the dev (Sui testnet) environment on CommandOSS's Railway.
' This is the only live testnet environment: the staging hosts were retired on 2026-10-27.
' Verified against the repo and the live /health and /config endpoints on 2026-11-12.
!include <C4/C4_Deployment>

LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()
skinparam wrapWidth 260
skinparam maxMessageSize 160
skinparam defaultFontSize 13
skinparam dpi 110

title Walrus Memory dev deployment (Sui testnet)

Deployment_Node(user, "User device", "Laptop or desktop") {
  Deployment_Node(browser, "Web browser", "Chrome, Safari, Firefox") {
    Container(spa, "Dashboard SPA", "React, Vite bundle", "Loaded from dev.memwal.ai")
  }
  Deployment_Node(agenthost, "AI client", "Claude Code, Cursor, Codex") {
    Container(mcp, "MCP connector", "npx @mysten-incubation/memwal-mcp", "Started with the dev or staging preset (same host)")
  }
}

Deployment_Node(cf, "Cloudflare", "DNS and proxy for memwal.ai") {
  Container(cfproxy, "Cloudflare proxy", "CDN, TLS", "dev.memwal.ai and relayer.dev.memwal.ai")
}

Deployment_Node(railway, "Railway, project MemWal (CommandOSS)", "Railway runtime V2, environment: dev") {
  Deployment_Node(edge, "Railway edge", "TLS termination, custom domains") {
    Container(edgeproxy, "Edge proxy", "railway-hikari", "Origin for the memwal.ai hosts")
  }
  Deployment_Node(relayersvc, "Service: relayer", "Docker image services/server/Dockerfile, 1 replica, restart on failure") {
    Container(relayer, "Relayer API", "memwal-server (Rust), :8000", "Public API, /health, /config, /metrics")
    Container(sidecar, "Sidecar", "tsx sidecar-server.ts, :9000 + Seal listener", "Seal, Walrus uploads, server wallets, hosted MCP")
  }
  Deployment_Node(appsvc, "Service: dashboard", "Docker image apps/app/Dockerfile, 1 replica") {
    Container(dashboard, "Static server", "node server.mjs", "Serves the dashboard bundle")
  }
  Deployment_Node(redissvc, "Service: Redis", "Railway Redis") {
    ContainerDb(redis, "Redis", "Redis", "Nonces, rate limits, caches")
  }
  Deployment_Node(indexersvc, "Service: indexer", "Docker image services/indexer/Dockerfile, 1 replica") {
    Container(indexer, "Indexer", "memwal-indexer (Rust)", "checkpoints.testnet.sui.io, from checkpoint 360074900")
  }
}

Deployment_Node(dbhost, "Managed Postgres (CommandOSS)", "Host not recorded in the repo") {
  ContainerDb(pg, "PostgreSQL", "pgvector", "Testnet database")
}

Deployment_Node(ext, "External services (testnet)", "Third party and Mysten operated") {
  System_Ext(sui, "Sui testnet", "gRPC mysten-rpc.testnet.sui.io (primary). JSON-RPC fallback sui-testnet-endpoint.blockvision.org. Checkpoint bucket.")
  System_Ext(walrus, "Walrus testnet", "Upload relay, publisher, aggregators")
  System_Ext(seal, "Seal key servers", "Testnet key servers")
  System_Ext(enoki, "Enoki", "Sponsorship, zkLogin")
  System_Ext(llm, "LLM gateway", "OpenRouter")
  System_Ext(slack, "Slack", "Alert webhook")
}

Rel(spa, cfproxy, "HTTPS")
Rel(mcp, cfproxy, "HTTPS, MCP over SSE")
Rel(cfproxy, edgeproxy, "HTTPS")
Rel(edgeproxy, dashboard, "HTTP")
Rel(edgeproxy, relayer, "HTTP")
Rel(relayer, sidecar, "HTTP, localhost")
Rel(relayer, redis, "Private network")
Rel(relayer, pg, "TLS")
Rel(indexer, pg, "TLS")
Rel(relayer, llm, "HTTPS")
Rel(relayer, slack, "HTTPS")
Rel(relayer, sui, "gRPC")
Rel(sidecar, sui, "gRPC")
Rel(sidecar, walrus, "HTTPS")
Rel(sidecar, seal, "HTTPS")
Rel(sidecar, enoki, "HTTPS")
Rel(indexer, sui, "HTTPS checkpoints")

note as retired
  **Retired staging hosts (2026-10-27)**
  relayer-staging.memory.walrus.xyz and staging.memory.walrus.xyz
  no longer serve a valid certificate. Testnet traffic, the MCP
  staging preset and the status page now use the dev hosts.
end note

Lay_D(relayer, sidecar)
Lay_R(redis, indexer)

SHOW_LEGEND()
@enduml
