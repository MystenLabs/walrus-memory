@startuml deployment-production
' Deployment of the production (Sui mainnet) environment on CommandOSS's Railway.
' Verified against the repo and the live /health and /config endpoints on 2026-11-12.
!include <C4/C4_Deployment>

LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()
skinparam wrapWidth 260
skinparam maxMessageSize 160
skinparam defaultFontSize 13
skinparam dpi 110

title Walrus Memory production deployment (Sui mainnet)

Deployment_Node(user, "User device", "Laptop or desktop") {
  Deployment_Node(browser, "Web browser", "Chrome, Safari, Firefox") {
    Container(spa, "Dashboard SPA", "React, Vite bundle", "Loaded from memory.walrus.xyz")
  }
  Deployment_Node(agenthost, "AI client", "Claude Code, Cursor, Codex") {
    Container(mcp, "MCP connector", "npx @mysten-incubation/memwal-mcp", "Default relayer: relayer.memory.walrus.xyz")
  }
}

Deployment_Node(railway, "Railway, project MemWal (CommandOSS)", "Railway runtime V2, environment: production") {
  Deployment_Node(edge, "Railway edge", "TLS termination, custom domains") {
    Container(edgeproxy, "Edge proxy", "railway-hikari", "memory.walrus.xyz and relayer.memory.walrus.xyz")
  }
  Deployment_Node(relayersvc, "Service: relayer", "Docker image services/server/Dockerfile, 1 replica, restart on failure") {
    Container(relayer, "Relayer API", "memwal-server (Rust), :8000", "Public API, /health, /config, /metrics")
    Container(sidecar, "Sidecar", "tsx sidecar-server.ts, :9000 + Seal listener", "Seal, Walrus uploads, server wallets, hosted MCP")
  }
  Deployment_Node(appsvc, "Service: dashboard", "Docker image apps/app/Dockerfile, 1 replica") {
    Container(dashboard, "Static server", "node server.mjs", "Serves the dashboard bundle")
  }
  Deployment_Node(redissvc, "Service: Redis", "Railway Redis") {
    ContainerDb(redis, "Redis", "Redis", "Nonces, rate limits, caches")
  }
  Deployment_Node(indexersvc, "Service: indexer", "Docker image services/indexer/Dockerfile, 1 replica") {
    Container(indexer, "Indexer", "memwal-indexer (Rust)", "Mainnet checkpoint bucket, starts before the mainnet package publish")
  }
}

Deployment_Node(neon, "Neon (CommandOSS)", "Managed serverless Postgres") {
  Deployment_Node(neonbranch, "Branch production", "database memwal") {
    ContainerDb(pg, "PostgreSQL", "pgvector", "Only full copy of jobs, OAuth state, owner tokens and quotas")
  }
}

Deployment_Node(ext, "External services (mainnet)", "Third party and Mysten operated") {
  System_Ext(sui, "Sui mainnet", "gRPC mysten-rpc.mainnet.sui.io (primary). JSON-RPC fallback rpc-mainnet.suiscan.xyz. Checkpoint bucket.")
  System_Ext(walrus, "Walrus mainnet", "Upload relay, publisher, aggregators")
  System_Ext(seal, "Seal key servers", "Mainnet committee")
  System_Ext(enoki, "Enoki", "Sponsorship, zkLogin")
  System_Ext(llm, "LLM gateway", "OpenRouter")
  System_Ext(slack, "Slack", "Alert webhook")
}

Rel(spa, edgeproxy, "HTTPS")
Rel(mcp, edgeproxy, "HTTPS, MCP over SSE")
Rel(edgeproxy, dashboard, "HTTP")
Rel(edgeproxy, relayer, "HTTP")
Rel(relayer, sidecar, "HTTP, localhost")
Rel(relayer, redis, "Private network")
Rel(relayer, pg, "TLS")
Rel(indexer, pg, "TLS")
Rel(relayer, llm, "HTTPS")
Rel(relayer, slack, "HTTPS")
Rel(relayer, sui, "gRPC")
Rel(sidecar, sui, "gRPC")
Rel(sidecar, walrus, "HTTPS")
Rel(sidecar, seal, "HTTPS")
Rel(sidecar, enoki, "HTTPS")
Rel(indexer, sui, "HTTPS checkpoints")

Lay_D(relayer, sidecar)
Lay_R(redis, indexer)

SHOW_LEGEND()
@enduml
