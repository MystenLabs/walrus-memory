{
  "name": "memwal-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sdk": "pnpm --filter @mysten-incubation/memwal build",
    "dev:sdk": "pnpm --filter @mysten-incubation/memwal dev",
    "dev:noter": "pnpm --filter noter dev",
    "dev:chatbot": "pnpm --filter chatbot dev",
    "dev:app": "pnpm --filter app dev",
    "dev:status": "pnpm --filter @memwal/status dev",
    "dev:researcher": "pnpm --filter researcher dev",
    "dev:docs": "pnpm --filter memwal-docs dev",
    "build:docs": "pnpm --filter memwal-docs build",
    "preview:docs": "pnpm --filter memwal-docs serve",
    "verify:memwal": "tsx scripts/verify-memwal-credentials.ts",
    "check:compatibility": "node scripts/check-compatibility-contract.mjs",
    "check:mcp-pin": "node scripts/check-mcp-pin.mjs",
    "tx:publish": "tsx scripts/build-publish-tx.ts",
    "tx:create-caps": "tsx scripts/build-migration-caps-tx.ts",
    "tx:finalize": "tsx scripts/build-finalize-tx.ts",
    "tx:burn-cap": "tsx scripts/build-burn-cap-tx.ts",
    "distribute:funds": "tsx scripts/distribute-funds.ts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@mysten/sui": "^2.20.3",
    "@types/node": "^22",
    "prettier": "2.8.8",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.12.3",
  "pnpm": {
    "overrides": {
      "protobufjs": "^7.5.5",
      "@modelcontextprotocol/sdk": "1.32.1",
      "proxy-addr": "2.0.8",
      "fast-uri": "3.1.8",
      "hono": "^4.13.11",
      "prosemirror-model": "1.25.12",
      "prosemirror-view": "1.42.3",
      "@grpc/grpc-js": "^1.14.5",
      "axios": "^1.20.0",
      "adm-zip": "^0.6.1",
      "brace-expansion@^1": "^1.1.20",
      "brace-expansion@^2": "^2.1.6",
      "brace-expansion@^5": "^5.0.11",
      "browserslist": "^4.28.7",
      "flatted": "^3.4.2",
      "image-size@^2": "^2.0.3",
      "ip-address": "^10.7.4",
      "js-yaml@^3": "^3.15.2",
      "js-yaml@^4": "^4.3.2",
      "linkify-it@^5": "^5.0.2",
      "lodash": "^4.18.0",
      "markdown-it@^14": "^14.3.3",
      "path-to-regexp@^8": "^8.4.0",
      "picomatch@^2": "^2.3.2",
      "picomatch@^4": "^4.0.4",
      "postcss@^8": "^8.5.23",
      "source-map-js": "^1.2.2",
      "sharp": "0.35.5",
      "undici@^7": "^7.29.1",
      "vue": "^3.5.42",
      "vite@^7": "^7.3.7",
      "undici@^6": "^6.27.0"
    }
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "docs"
  ]
}
